# Single source of truth for feature flags.
# This file is read by both react-native-config (JS) and the dotenv.gradle script (Android build).
# Set PUSH_ENABLED=true only when a valid google-services.json
PUSH_ENABLED=true

# If you want to use your own implementation of FirebaseMessagingService instead of the default one provided 
# by the bluedot-react-native-pushnotifications package, you need to declare your service in your AndroidManifest.xml.
# We're using a feature flag to conditionally include the declaration
#
# Controls whether the Android-specific Firebase push override is active.
# true  → CustomMessagingService + Firebase push deps are included (current behaviour)
# false → they are excluded; the leaner build omits those deps and the manifest <service> entry
PUSH_ANDROID_OVERRIDE=false
